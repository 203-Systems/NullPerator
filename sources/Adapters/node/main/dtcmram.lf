# Map `.DTCMRAM*` sections into internal DRAM BSS for ESP-IDF builds.
# These sections are used by the ADV target (STM32 DTCM) for fast buffers, but on ESP32-S3
# they must not end up in the flash-mapped DROM region.

[sections:dtcmram]
entries:
    .DTCMRAM+

[scheme:dtcmram_to_bss]
entries:
    dtcmram -> dram0_bss

[mapping:dtcmram_services_audio]
archive: libservices_audio.a
entries:
    * (dtcmram_to_bss)

[mapping:dtcmram_application_instruments]
archive: libapplication_instruments.a
entries:
    * (dtcmram_to_bss)

