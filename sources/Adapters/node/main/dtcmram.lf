# Map `.DTCMRAM*` sections into internal DRAM BSS for ESP-IDF builds.
# Keep fast-buffer sections in ESP32-S3 internal DRAM rather than the
# flash-mapped DROM region.

[sections:dtcmram]
entries:
    .DTCMRAM+

[scheme:dtcmram_to_bss]
entries:
    dtcmram -> dram0_bss

[mapping:dtcmram_services_audio]
archive: libservices_audio.a
entries:
    * (dtcmram_to_bss)

[mapping:dtcmram_platform_audio]
archive: libplatform_audio.a
entries:
    * (dtcmram_to_bss)

[mapping:dtcmram_application_instruments]
archive: libapplication_instruments.a
entries:
    * (dtcmram_to_bss)

[mapping:dtcmram_application_mixer]
archive: libapplication_mixer.a
entries:
    * (dtcmram_to_bss)
